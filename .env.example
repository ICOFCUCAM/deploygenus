# ---------------------------------------------------------------------------
# Forge — copy to .env and fill in. Nothing here has a working default; the
# control plane refuses to start rather than run with a guessed secret.
# ---------------------------------------------------------------------------

# The wildcard this platform owns. Every deployment is served at
# <deployment-id>.FORGE_DEPLOY_DOMAIN, so this needs a DNS record:
#
#     *.deploys.example.com.   A   <this host's IP>
#      deploys.example.com.    A   <this host's IP>
#
FORGE_DEPLOY_DOMAIN=deploys.example.com

# Bearer token for the control plane API and dashboard.
#   openssl rand -hex 32
FORGE_API_TOKEN=

# Encrypts every stored environment variable. Losing it makes all of them
# unreadable; changing it has the same effect, so keep a backup.
#   forge keygen
FORGE_MASTER_KEY=

# --- TLS -------------------------------------------------------------------
# Leave FORGE_CERT_RESOLVER empty for local development and everything is
# served over plain HTTP. In production it must be set, and the control plane
# refuses to start without it.
FORGE_CERT_RESOLVER=le
FORGE_ACME_EMAIL=you@example.com

# The wildcard certificate is issued over a DNS-01 challenge, which is the
# only ACME challenge that can prove control of *.your-domain — and a wildcard
# is not a nicety here. Each deploy invents a new hostname, and per-hostname
# certificates would burn through Let's Encrypt's weekly limit of 50 in about
# a week of ordinary work. Set the provider your DNS is hosted with, plus
# whatever token that provider needs.
#   https://doc.traefik.io/traefik/https/acme/#providers
FORGE_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=

# --- Database --------------------------------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://forge:@postgres:5432/forge

# --- Paths and limits ------------------------------------------------------
FORGE_NETWORK=forge
FORGE_BUILD_ROOT=/var/lib/forge/builds
FORGE_ROUTER_CONFIG_DIR=/var/lib/forge/router
FORGE_BUILD_TIMEOUT=1800
FORGE_HEALTH_TIMEOUT=90
FORGE_HEALTH_PATH=/
ENVIRONMENT=production

# --- Alerts ----------------------------------------------------------------
# A Slack or Discord incoming-webhook URL (anything that accepts a JSON POST).
# Forge posts when a production deploy fails, a site stops answering, a worker
# stops, a scheduled job starts failing, the disk passes the threshold, or a
# backup fails — once when it starts and once when it recovers.
# Check it with:  docker compose exec api forge test-alert
FORGE_ALERT_WEBHOOK_URL=
FORGE_DISK_ALERT_PERCENT=90

# --- Backups ---------------------------------------------------------------
# Daily, at FORGE_BACKUP_HOUR UTC: the database and every volume. The path is
# inside the worker container; docker-compose.yml mounts it from
# FORGE_BACKUP_HOST_DIR on the host. Copy it somewhere else as well — a backup
# on the same disk does not survive the disk.
# FORGE_MASTER_KEY is deliberately NOT in the backups. Keep it separately.
FORGE_BACKUP_DIR=/var/backups/forge
FORGE_BACKUP_HOST_DIR=/var/backups/forge
FORGE_BACKUP_HOUR=3
FORGE_BACKUP_KEEP=7

# --- Cleanup ---------------------------------------------------------------
# Hourly: images beyond production, warm deployments and the newest
# FORGE_KEEP_IMAGES rollback targets are removed; build cache unused for a
# week is pruned; logs older than FORGE_LOG_RETENTION_DAYS are deleted.
FORGE_KEEP_IMAGES=10
FORGE_LOG_RETENTION_DAYS=30
